# Local tools only — copy to .env (gitignored). Robinhood tokens go in tokens.json → Secrets Manager.

AWS_PROFILE=mastalcup

AWS_REGION=us-east-1

ANTHROPIC_API_KEY=sk-ant-...

ANTHROPIC_MODEL=claude-sonnet-4-6

AGENT_DISCORD_CHANNEL_ID=



# Cross-feed context (sibling stacks — defaults match deployed table names)

