# Market Pulse — Environment Variables
# Copy to .env and fill in your values
# Free tier keys are sufficient to start

# ── Data Sources ──────────────────────────────────────────────────────────────
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
# Free: 25 req/day — sufficient for 1 daily run
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# NewsAPI: https://newsapi.org/register
# Free: 100 req/day — sufficient for 8 topic queries
NEWS_API_KEY=your_newsapi_key_here

# ── AI ────────────────────────────────────────────────────────────────────────
# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Discord ───────────────────────────────────────────────────────────────────
# Create webhook: Discord Channel Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# ── AWS (auto-set in Lambda, needed for local DynamoDB) ───────────────────────
AWS_REGION=us-east-1
DYNAMODB_TABLE=market-pulse

# ── Local Dev ────────────────────────────────────────────────────────────────
# Set to 'true' to bypass DynamoDB and run fully locally
LOCAL_MODE=true
